# ------------------------------------------------------------
# Soprano — variáveis de ambiente
# ------------------------------------------------------------
# Copiar para .env.local (dev) ou configurar no painel Vercel (prod).

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role — opcional, mas necessário para:
#  - envio automático de email (lookup de email do cliente/supervisor)
#  - tarefas administrativas
# NUNCA expor no cliente. Nome não começa com NEXT_PUBLIC_ de propósito.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (opcional — Resend.com) ---
# Quando presentes, notificações automáticas são enviadas:
#  - cliente recebe email ao receber atividade para assinar
#  - supervisor recebe email quando cliente assina
RESEND_API_KEY=
RESEND_FROM="Soprano <noreply@seu-dominio.com>"

# --- Mapa (opcional — Mapbox) ---
# Quando presente, o mapa Linha 6 renderiza as estações/VSEs geolocalizados.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Observabilidade (opcional — Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
